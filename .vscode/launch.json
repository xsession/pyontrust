{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NiceGUI: Run pyontrust_gui (module)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv-nicegui\\Scripts\\python.exe",
      "module": "pyontrust_gui",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYONTRUST_GUI_PORT": "8081"
      }
    },
    {
      "name": "NiceGUI: Run app.py (script)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv-nicegui\\Scripts\\python.exe",
      "program": "${workspaceFolder}\\gui_app\\nicegui_control\\src\\pyontrust_gui\\app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYONTRUST_GUI_PORT": "8081"
      }
    }
  ]
}
