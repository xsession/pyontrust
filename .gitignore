# ═══════════════════════════════════════════════════════════
# pyontrust — .gitignore (single source of truth)
# Convention: generated/runtime output lives under data/, dist/,
# site/ and tools/*/generated/ — never commit it.
# ═══════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv*/

# ── Virtual environments (legacy locations) ───────────────
gui_app/pin_configurator/.venv/
externals/pin_configurator/.venv/
externals/pin_configurator/vscode-extension/node_modules/
externals/pin_configurator/electron/node_modules/
externals/pin_configurator/.tmp/

# ── Runtime data & generated output (regenerable) ─────────
/data/aoi_images/
/data/sim_output/
/test_reports/
/artifacts/
/layout.json.tmp
/test_result.json
/aoi_results.db
tools/interface-generator/generated/

# ── Documentation build output ────────────────────────────
/site/

# ── OS / editor noise ─────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
