{
  "name": "default",
  "description": "Default HIL profile: current draw of the target with the PPK2 as an in-line ampere meter (the PPK2 does not power the target). Baseline, measurement window, settle.",
  "instruments": {
    "power_meter": {
      "type": "ppk2",
      "serial_port": "auto",
      "mode": "ampere",
      "sample_rate_hz": 100000
    }
  },
  "recorders": [],
  "steps": [
    {
      "name": "baseline",
      "duration_s": 2.0,
      "description": "Target as found — baseline current",
      "actions": [{ "type": "mark", "label": "baseline_start" }]
    },
    {
      "name": "measure",
      "duration_s": 10.0,
      "description": "Measurement window",
      "actions": [{ "type": "mark", "label": "measure_start" }]
    },
    {
      "name": "settle",
      "duration_s": 2.0,
      "description": "Settle / end of run",
      "actions": [{ "type": "mark", "label": "settle_start" }]
    }
  ],
  "meta": { "default": true }
}
