{
  "name": "default_bench",
  "description": "Default lab bench: the instruments of this station (PPK2 power meter, Seek thermal camera, Android phone sensors). Instruments are only created on Connect, not opened.",
  "instruments": [
    {
      "type": "ppk2",
      "enabled": true,
      "params": {
        "serial_port": "auto",
        "mode": "ampere",
        "sample_rate_hz": 100000
      }
    },
    {
      "type": "seek_thermal",
      "enabled": true,
      "params": {
        "mode": "seek",
        "camera_type": "auto",
        "emissivity": 0.95
      }
    },
    {
      "type": "android_sensors",
      "enabled": true,
      "params": {
        "mode": "adb"
      }
    }
  ]
}
