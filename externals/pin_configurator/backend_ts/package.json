{
  "name": "pin-configurator-backend-ts",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "prebuild": "python scripts/export_boards.py",
    "build": "tsc -p .",
    "start": "node dist/server_entry.js",
    "organize:runtime": "node scripts/normalize_runtime_layout.js",
    "digest:uploads": "node scripts/digest_uploads.js",
    "check:native-sensors": "node scripts/validate_native_sensor_samples.js",
    "check:native-mcus": "node scripts/validate_native_mcu_samples.js",
    "smoke:api-sensor": "node scripts/smoke_api_sensor.js",
    "smoke:api-mcu": "node scripts/smoke_api_mcu.js",
    "check:all-native": "npm run check:native-sensors && npm run check:native-mcus && npm run smoke:api-sensor && npm run smoke:api-mcu",
    "validate:vendor-matrix": "node scripts/run_vendor_matrix.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  }
}