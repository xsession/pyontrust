<script>
(function() {
  const API_BASE = "{{ api_base|default('') }}";

  window.ifdocFetch = function(endpoint, params, resultEl) {
    resultEl.textContent = "…";
    const url = API_BASE + endpoint;
    const opts = params
      ? {method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify(params)}
      : {method: "GET"};
    fetch(url, opts)
      .then(r => r.json())
      .then(d => { resultEl.textContent = JSON.stringify(d, null, 2); })
      .catch(e => { resultEl.textContent = "ERROR: " + e; });
  };

  window.ifdocRead = function(endpoint, resultEl) {
    ifdocFetch(endpoint, null, resultEl);
  };

  window.ifdocWrite = function(endpoint, formEl, resultEl) {
    const fd = new FormData(formEl);
    const params = {};
    for (const [k, v] of fd.entries()) {
      params[k] = isNaN(Number(v)) ? v : Number(v);
    }
    ifdocFetch(endpoint, params, resultEl);
  };
})();
</script>