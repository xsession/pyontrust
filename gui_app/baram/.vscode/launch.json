{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "inputs": [
        {
            "id": "releaseVersion",
            "type": "promptString",
            "description": "Git tag/ref for binaries (e.g. v1.2.3)",
            "default": "v1.2.3"
        }
    ],
    "configurations": [
        {
            "name": "baramFlow",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "pythonPath": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "debugAdapterPython": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "module": "baramFlow.main",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Generate: Qt resources (convertUi)"
        },
        {
            "name": "baramMesh",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "pythonPath": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "debugAdapterPython": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "module": "baramMesh.main",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Generate: Qt resources (convertUi)"
        },
        {
            "name": "Binaries: Build (PyInstaller)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "pythonPath": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "debugAdapterPython": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "program": "${workspaceFolder}/tools/build_binaries.py",
            "args": [
                "--clean"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "Prep: binaries (deps + Qt)"
        },
        {
            "name": "Binaries: Package zip (make_binary_release)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "pythonPath": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "debugAdapterPython": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "program": "${workspaceFolder}/tools/make_binary_release.py",
            "args": [
                "--version",
                "${input:releaseVersion}",
                "--clean"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "Prep: binaries (deps + Qt)"
        }
    ]
}